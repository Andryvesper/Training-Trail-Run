{
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.input.css -o css/app.css --minify",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:e2e": "node --test --test-concurrency=1 e2e/app.e2e.mjs",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright-core": "1.64.1",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.17"
  }
}
